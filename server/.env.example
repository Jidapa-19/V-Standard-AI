# คัดลอกไฟล์นี้เป็น server/.env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
# รับ API Key ได้ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3001
HOST=127.0.0.1

# โดเมนที่อนุญาตให้เรียก API (คั่นด้วย comma)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

RATE_LIMIT_PER_MINUTE=20
GEMINI_TIMEOUT_MS=30000
